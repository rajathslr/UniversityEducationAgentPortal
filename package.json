{
  "name": "agentms",
  "version": "1.0.0",
  "description": "Education Agent Management System — demo build (College + Agent views)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "gen-cert": "node scripts/gen-cert.js",
    "setup": "node scripts/migrate.js --fresh && node scripts/seed.js --force && node scripts/gen-cert.js",
    "reset": "node scripts/migrate.js --fresh && node scripts/seed.js --force",
    "test": "node --test",
    "migrate:fresh": "node scripts/migrate.js --fresh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "selfsigned": "^2.4.1"
  }
}

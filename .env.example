# Copy to .env and adjust to match your local Postgres.
# The migrate script connects to the "postgres" maintenance DB using this URL's
# credentials, creates the target database if missing, then runs the schema.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentms
PORT=3000

# Logging
LOG_LEVEL=info
# LOG_TO_FILE=0   # set to 0 to disable the logs/app-<date>.log file (console only)

# Auth
SESSION_TTL_HOURS=8
# Optional: if set, plain HTTP on this port 301-redirects to HTTPS on PORT.
# HTTP_REDIRECT_PORT=8080

# Bootstrap admin (seed script only). CHANGE THESE before any real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!23
# Default password for seeded officer/agent demo logins.
SEED_USER_PASSWORD=Passw0rd!23

# Dify reference-check automation. API key from Dify's Workflow #1 app
# ("Access API" panel) — must start with "app-", not "re_" (that prefix is
# a different service's key format).
DIFY_API_KEY=app-changeme
# The referee-facing form (Workflow #2). Sent as part of the callback_url.
DIFY_CALLBACK_FORM_URL=https://udify.app/workflow/kDjAPPfnY85ew1kl
# Free-tier Dify plan can only send to one address. Every reference-check
# email goes here regardless of what the agent entered as the referee's
# email — that value is still stored on the record for reference, just
# never used as the send target.
REFEREE_NOTIFY_EMAIL=changeme@example.com
